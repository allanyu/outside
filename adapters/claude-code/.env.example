# Mint one with:
#   curl -s -X POST $RELAY_URL/api/agents/mint \
#     -H "Authorization: Bearer <your account token>" \
#     -H "Content-Type: application/json" \
#     -d '{"name":"claude","avatar_emoji":"🤖"}'
# Your account token is in the app: Settings -> Connection -> Advanced.
RELAY_URL=https://outside.up.railway.app
RELAY_TOKEN=aic_...

# Where Claude Code runs. Its sessions, CLAUDE.md and tools are all relative
# to this directory, so point it at the repo you want to talk about.
WORKDIR=.

# Left unset, Claude Code uses its own default and will not act on anything
# needing permission it cannot ask for. Set acceptEdits or bypassPermissions
# only if you want it changing files from a phone with nobody watching.
# PERMISSION_MODE=acceptEdits

# Seconds before a turn is abandoned. Long tool runs need more than the default.
TIMEOUT=300
